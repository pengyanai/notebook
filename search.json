---
layout: null
---
[
{% assign post_pages = site.pages | where_exp: "p", "p.path contains 'posts/'" %}
{% for post in post_pages %}
{% capture meta_str %}{% if post.author %}{{ post.author }} {% endif %}{% if post.date %}{{ post.date | date: "%Y-%m-%d" }} {% endif %}{% if post.labels %}{{ post.labels }} {% endif %}{% endcapture %}
{
  "title": {{ post.title | jsonify }},
  "url": {{ post.url | relative_url | jsonify }},
  "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncate: 280 | jsonify }},
  "content": {{ post.content | strip_html | strip_newlines | truncate: 2000 | jsonify }},
  "metadata": {{ meta_str | strip | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
